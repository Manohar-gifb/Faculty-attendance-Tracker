# ============================================================
# Security & Privacy: Database Dumps & Sensitive Data
# ============================================================
backups/
*.dump
backups/*.sql
# Preserve required Flyway versioned migrations and schema scripts
!facultybackend/src/main/resources/db/migration/*.sql
!database/*.sql
!database/migrations/*.sql

# Temporary credentials generated by backup/restore automation
*.cnf

# ============================================================
# Environment Files & Secrets (Never commit live credentials)
# ============================================================
.env
.env.*
.env.local
.env.production
!.env.example
*.pem
*.key
*.p12

# ============================================================
# Java / Spring Boot Artifacts
# ============================================================
facultybackend/target/
target/
*.class
*.jar
*.war
.mvn/wrapper/maven-wrapper.jar
*.mv.db
*.trace.db
hs_err_pid*.log
replay_pid*.log
facultybackend/.apt_generated/
facultybackend/.apt_generated_tests/
facultybackend/.classpath
facultybackend/.project
facultybackend/.settings/

# ============================================================
# Node / Frontend Artifacts
# ============================================================
frontend/node_modules/
node_modules/
frontend/dist/
dist/
.eslintcache
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ============================================================
# Uploaded User Biometrics & Photos
# ============================================================
uploads/*
!uploads/profile-pictures/
uploads/profile-pictures/*
!uploads/profile-pictures/.gitkeep

facultybackend/uploads/*
!facultybackend/uploads/profile-pictures/
facultybackend/uploads/profile-pictures/*
!facultybackend/uploads/profile-pictures/.gitkeep

# ============================================================
# Python Artifacts (Face Verification Service)
# ============================================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
face_verification/venv/
face_verification/.venv/
face_verification/.env/
venv/
env/
.venv/

# ============================================================
