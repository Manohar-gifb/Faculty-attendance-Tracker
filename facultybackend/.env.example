# ============================================================
# College Faculty Attendance & Management System - Backend .env.example
# Copy this file to .env and replace placeholder values with your actual configuration.
# ============================================================

# Database Configuration (MySQL 8.0)
DB_URL=jdbc:mysql://localhost:3307/college_attendance?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# JWT Security (Must be a 256-bit Base64-encoded secret in production)
JWT_SECRET=your_256_bit_base64_encoded_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# Gmail SMTP Configuration (For activation & leave approval notification emails)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_16_char_google_app_password

# Frontend URL (For activation & password reset links in emails)
FRONTEND_URL=http://localhost:3000

# Python Face Verification Microservice
FACE_VERIFICATION_SERVICE_URL=http://localhost:5001
INTERNAL_SERVICE_SECRET=your_secure_internal_service_secret_here
FACE_CONNECT_TIMEOUT_MS=5000
FACE_READ_TIMEOUT_MS=15000

# File Upload Directory (Defaults to C:/FacultyAttendance/uploads/profile-pictures on Windows)
# On Linux/Docker, set UPLOAD_DIR to an absolute path, e.g. /var/faculty/uploads/profile-pictures
# UPLOAD_DIR=C:/FacultyAttendance/uploads/profile-pictures
