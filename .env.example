# ============================================================
# Faculty Sync Tracker (Formerly College Faculty Attendance System)
# Production Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to .env:
#    cp .env.example .env (Linux/macOS) or copy .env.example .env (Windows)
# 2. Fill in strong production secrets. Do NOT commit .env to version control.
# 3. In production (SPRING_PROFILES_ACTIVE=prod), the backend fails closed on startup
#    if JWT_SECRET, INTERNAL_SERVICE_SECRET, or DB_PASSWORD use development defaults.
# ============================================================

# ============================================================
# 1. DATABASE CONFIGURATION (MySQL 8.0)
# ============================================================
DB_NAME=college_attendance
DB_USERNAME=faculty_user
# Production password: MUST be a strong password, not 'password' or 'root'
DB_PASSWORD=your_strong_db_password_here
DB_ROOT_PASSWORD=your_strong_mysql_root_password_here

# Optional: When connecting to an existing external database (e.g. AWS RDS or institutional MySQL)
# instead of the Compose db container, uncomment and configure DB_URL:
# DB_URL=jdbc:mysql://mysql.internal.college.edu:3306/college_attendance?useSSL=true&serverTimezone=UTC

# ============================================================
# 2. APPLICATION SECURITY SECRETS (MANDATORY IN PRODUCTION)
# ============================================================
# Generate with: openssl rand -base64 48
JWT_SECRET=replace_with_a_cryptographically_strong_256_bit_base64_secret_key_here
JWT_EXPIRATION_MS=86400000

# Inter-service authentication shared secret between Spring Boot backend and Python face service
# Generate with: openssl rand -hex 24 (minimum 16 characters)
INTERNAL_SERVICE_SECRET=replace_with_a_secure_random_internal_service_secret_key_here

# ============================================================
# 3. WEB & REVERSE PROXY NETWORKING
# ============================================================
# Host port on which Nginx web frontend is exposed
FRONTEND_PORT=3000

# Public URL of the frontend (used for activation & password setup email links)
# In production, set to your canonical domain, e.g. https://attendance.college.edu
FRONTEND_URL=http://localhost:3000

# Additional comma-separated allowed CORS origins (if external portals query the API directly)
CORS_ALLOWED_ORIGINS=https://attendance.college.edu

# ============================================================
# 4. DATABASE MIGRATIONS (FLYWAY) & DDL SAFETY
# ============================================================
# Safe adoption: defaults to 'false' so schema is managed safely.
# Set to 'true' once baseline V1 has been reconciled with the database.
FLYWAY_ENABLED=false

# Hibernate schema verification in production: 'validate' ensures Hibernate
# never alters or drops production tables, only verifies entity mappings.
DDL_AUTO=validate

# ============================================================
# 5. SMTP EMAIL NOTIFICATIONS (GMAIL / COLLEGE SMTP)
# ============================================================
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_college_notifications@gmail.com
MAIL_PASSWORD=your_16_character_app_specific_password

# ============================================================
# 6. PROFILE PICTURE STORAGE
# ============================================================
# Inside Docker containers, photos persist in the named volume 'faculty_uploads_data'
# mounted at /var/faculty/uploads/profile-pictures (backend) and /app/uploads/profile-pictures (face service).
#
# NOTE FOR EXISTING WINDOWS DEPLOYMENTS:
# If you have existing live profile pictures in C:/FacultyAttendance/uploads/profile-pictures,
# they remain safe and untouched on your Windows host.
# ============================================================
