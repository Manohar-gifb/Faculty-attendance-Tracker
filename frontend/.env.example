# ============================================================
# COLLEGE LOCATION (for geolocation-based attendance)
# ============================================================
VITE_COLLEGE_LATITUDE=12.9716
VITE_COLLEGE_LONGITUDE=77.5946
VITE_COLLEGE_RADIUS_METERS=1000

# ============================================================
# API BASE URL
# For local dev: /api (Vite proxy forwards to localhost:8081)
# For production (Vercel): https://your-backend-domain.com/api
# ============================================================
VITE_API_BASE_URL=/api

# ============================================================
# STATIC UPLOADS BASE URL (Optional)
# For local dev: leave unset (Vite proxy forwards /uploads to localhost:8081)
# For production: set if static uploads are hosted on a separate domain (e.g., https://your-backend-domain.com/uploads)
# ============================================================
# VITE_UPLOADS_URL=https://your-backend-domain.com/uploads

# ============================================================
# APP CONFIG
# ============================================================
VITE_SENDER_EMAIL=notifications@college.edu
VITE_APP_NAME=Faculty Sync Tracker
VITE_APP_URL=http://localhost:3000
